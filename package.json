{
  "name": "mac-notes",
  "version": "1.0.0",
  "description": "复刻 macOS 备忘录的桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.notes.desktop",
    "productName": "备忘录",
    "win": {
      "target": ["portable", "nsis"],
      "publisherName": "Notes"
    },
    "files": ["main.js", "preload.js", "index.html"]
  }
}
